/.deploy-webhook-url

# runtime-generated, regenerated by cron each run — includes API credentials & password hash
/logs/*.log
/logs/*.log.1
/data/*.sqlite
/data/*.sqlite-journal
/data/*.sqlite-wal
/data/*.sqlite-shm

